# Production settings for compose.prod.yaml (WP 8.6, ADR 0032). Copy to .env.prod on the server;
# never commit real values. Generate secrets, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# Public address. Local test: SITE_ADDRESS=localhost and PUBLIC_HOST=localhost.
SITE_ADDRESS=crashscouts.org
PUBLIC_HOST=crashscouts.org

DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Outgoing email (question F: Scaleway Transactional Email, WP 8.2, docs/OPERATIONS.md §12).
# Local test: DJANGO_EMAIL_HOST=mailpit, DJANGO_EMAIL_PORT=1025, DJANGO_EMAIL_USE_TLS=false and
# empty user and password; the mail catcher then runs (profile "local").
DJANGO_EMAIL_HOST=smtp.tem.scaleway.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
# Scaleway: the project ID and an API secret key that may only send email.
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=Crashscouts <no-reply@crashscouts.org>
# Server errors are mailed here without request data (WP 8.4, ADR 0034); empty turns them off.
DJANGO_ERROR_MAIL_TO=

# Open registration for the beta (owner's decision 2026-11-15).
DJANGO_SIGNUP_ENABLED=true

# GitHub login and repository verification: a GitHub OAuth app with the callback URLs
# https://<host>/accounts/github/login/callback/ and https://<host>/projects/github/verify/callback
# (OPERATIONS §14). Empty turns both off.
DJANGO_GITHUB_CLIENT_ID=
DJANGO_GITHUB_CLIENT_SECRET=

# Legal pages (ADR 0031): the SSR server refuses to start while these are empty.
PUBLIC_DEPLOYMENT=true
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=
LEGAL_TEXTS_REVIEWED=false
SOURCE_CODE_URL=
