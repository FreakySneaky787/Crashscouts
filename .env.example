# Vorlage für die lokale Konfiguration.
#   cp .env.example .env     und Werte anpassen.
# .env wird von Git ignoriert. Niemals echte Geheimnisse in diese Vorlage schreiben.

# --- Plattform ---
PLATFORM_NAME=TestHub

# --- PostgreSQL (lokale Entwicklung, nur an 127.0.0.1 gebunden) ---
POSTGRES_DB=testhub
POSTGRES_USER=testhub
# Lokales Entwicklungspasswort selbst wählen, z. B.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Django (nur Produktion zwingend; dev/test haben unsichere, klar markierte Standardwerte) ---
# DJANGO_SECRET_KEY=        # Produktion: mindestens 50 zufällige Zeichen
# DJANGO_ALLOWED_HOSTS=     # Produktion: kommagetrennte Hostnamen
# DJANGO_CSRF_TRUSTED_ORIGINS=
