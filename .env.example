# Template for the local configuration.
#   cp .env.example .env     and adjust the values.
# .env is ignored by Git. Never put real secrets into this template.

# --- Platform ---
PLATFORM_NAME=Crashscouts

# --- PostgreSQL (local development, bound to 127.0.0.1 only) ---
POSTGRES_DB=testhub
POSTGRES_USER=testhub
# Choose a local development password, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Django (required in production only; dev/test use insecure, clearly marked defaults) ---
# DJANGO_SECRET_KEY=        # production: at least 50 random characters
# DJANGO_ALLOWED_HOSTS=     # production: comma-separated host names
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Number of trusted reverse proxies in front of Django and the SSR server (rate limits per IP,
# ADR 0022). Development: 0, X-Forwarded-For is ignored. Production: required, normally 1; the
# reverse proxy must overwrite X-Forwarded-For with the client address.
# DJANGO_TRUSTED_PROXY_COUNT=0

# --- GitHub login (optional; without these the GitHub button is not shown) ---
# From a GitHub OAuth app with the callback http://localhost:3000/accounts/github/login/callback/.
# Store them in your local .env, Codespaces secrets or the environment settings - never in Git.
# DJANGO_GITHUB_CLIENT_ID=
# DJANGO_GITHUB_CLIENT_SECRET=

# --- Uploaded files (avatars) ---
# Development default: backend/media (ignored by Git). Production: required, persistent, outside the code.
# DJANGO_MEDIA_ROOT=

# --- Accounts and email ---
# Public URL of the SSR frontend; links in emails point here (production: https:// required).
# Use "localhost", not 127.0.0.1: passkeys (WebAuthn) reject IP addresses.
FRONTEND_URL=http://localhost:5173
# Signup is open in development by default; production keeps it closed unless set to true.
# DJANGO_SIGNUP_ENABLED=true
# Security gate: public campaigns stay drafts until phase 3B is met. Only the project owner
# switches this on, and only after the gate in docs/MVP-PLAN.md is fully met.
# PUBLIC_CAMPAIGNS_ENABLED=false
# SMTP. Development: Mailpit (docker compose up -d mailpit) on 127.0.0.1:1025, no credentials.
# Production: provider credentials come from the server's environment, never from this file.
# DJANGO_EMAIL_HOST=127.0.0.1
# DJANGO_EMAIL_PORT=1025
# DJANGO_EMAIL_USE_TLS=false
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=

# --- Legal pages and public deployment (WP 8.5, ADR 0031) ---
# The operator's details appear in the privacy policy and the imprint. Real values only on the
# server, never in the repository. With PUBLIC_DEPLOYMENT=true the SSR server refuses to start
# while one of them is empty. A line break in the address can be written as "\n".
PUBLIC_DEPLOYMENT=false
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=
# Set to true only after the professional review of the legal texts (shown as drafts until then).
LEGAL_TEXTS_REVIEWED=false
# Public address of the source code (AGPL footer link); https only. Empty: no link.
SOURCE_CODE_URL=
