# Template for the local configuration.
#   cp .env.example .env     and adjust the values.
# .env is ignored by Git. Never put real secrets into this template.

# --- Platform ---
PLATFORM_NAME=TestHub

# --- PostgreSQL (local development, bound to 127.0.0.1 only) ---
POSTGRES_DB=testhub
POSTGRES_USER=testhub
# Choose a local development password, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Django (required in production only; dev/test use insecure, clearly marked defaults) ---
# DJANGO_SECRET_KEY=        # production: at least 50 random characters
# DJANGO_ALLOWED_HOSTS=     # production: comma-separated host names
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Accounts and email ---
# Public URL of the SSR frontend; links in emails point here (production: https:// required).
FRONTEND_URL=http://127.0.0.1:5173
# Signup is open in development by default; production keeps it closed unless set to true.
# DJANGO_SIGNUP_ENABLED=true
# SMTP. Development: Mailpit (docker compose up -d mailpit) on 127.0.0.1:1025, no credentials.
# Production: provider credentials come from the server's environment, never from this file.
# DJANGO_EMAIL_HOST=127.0.0.1
# DJANGO_EMAIL_PORT=1025
# DJANGO_EMAIL_USE_TLS=false
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=
