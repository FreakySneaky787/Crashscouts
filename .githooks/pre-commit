#!/usr/bin/env bash
# Pre-commit checks (activated with: git config core.hooksPath .githooks).
# 1. Secret scan of the staged changes (gitleaks) – always, and it blocks the commit if gitleaks
#    is unavailable, because the private repository has no server-side push protection.
# 2. Ruff for staged backend files, ESLint for staged frontend files.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

GITLEAKS_IMAGE="zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"

echo "pre-commit: gitleaks (staged changes)"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact .
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  docker run --rm --user "$(id -u):$(id -g)" -v "$root:/repo" "$GITLEAKS_IMAGE" \
    git --staged --no-banner --redact /repo
else
  echo "pre-commit: gitleaks is not installed and Docker is unavailable." >&2
  echo "Install gitleaks (see CONTRIBUTING.md) – the commit is blocked for safety." >&2
  exit 1
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if grep -qE '^backend/.*\.py$' <<<"$staged"; then
  echo "pre-commit: ruff"
  (cd backend && uv run --frozen ruff check . && uv run --frozen ruff format --check .)
fi

if grep -qE '^frontend/.*\.(ts|tsx|js)$' <<<"$staged"; then
  echo "pre-commit: eslint"
  (cd frontend && pnpm --silent lint)
fi
